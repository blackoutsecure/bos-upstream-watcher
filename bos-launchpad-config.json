{
  "gate": {
    "enable_lint": true,
    "enable_python_lint": true,
    "python_version": "3.12",
    "enable_shell_lint": false
  },
  "marketplace": {
    "enabled": true,
    "target_branch": "main",
    "allowlist_paths": [
      "action.yml",
      "src",
      "README.md",
      "LICENSE",
      "NOTICE"
    ],
    "blocked_paths": [
      ".github/workflows/",
      ".editorconfig",
      ".gitattributes",
      ".gitignore",
      ".markdownlint.yaml",
      "pyproject.toml",
      "requirements-dev.txt",
      "test/"
    ],
    "required_paths": [
      ".github/dependabot.yml",
      "action.yml",
      "src",
      "LICENSE",
      "NOTICE",
      "README.md"
    ],
    "include_dependabot_config": true,
    "include_github_metadata": false
  },
  "sync_files": {
    "services": [
      "common",
      "lf_line_endings",
      "python",
      "dependabot_actions",
      "dependabot_pip",
      "bos_launchpad_config",
      "bos_universal_security",
      "bos_universal_marketplace",
      "bos_universal_sync"
    ],
    "mode": "commit"
  }
}
