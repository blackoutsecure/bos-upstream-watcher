# Repo-specific ignores live OUTSIDE the hub-managed marker block
# below. The hub's `common` block covers OS/editor noise, secrets,
# and logs; the `python_ecosystem` service covers Python venvs and
# caches. Only genuinely repo-specific artefacts live here.

# Local dev artefacts (repo-specific)
tracker-*.json
/tmp-*


# >>> managed-file-sync:common >>>
# OS + editor noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# Build + dependency output
node_modules/
dist/
build/
coverage/
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Local secrets (never commit these)
.env
.env.*
!.env.example
# <<< managed-file-sync:common <<<

# >>> managed-file-sync:coverage_artifacts >>>
.coverage
.coverage.*
coverage.xml
htmlcov/
# <<< managed-file-sync:coverage_artifacts <<<

# >>> managed-file-sync:python_ecosystem >>>
**/__pycache__/
**/.venv/
**/venv/
**/env/
**/.pytest_cache/
**/.ruff_cache/
**/.mypy_cache/
**/.tox/
**/.nox/
**/.coverage
**/coverage.xml
**/htmlcov/
*$py.class
*.egg
*.egg-info/
.eggs/
# <<< managed-file-sync:python_ecosystem <<<
